diff --git a/hotspot/src/share/vm/runtime/arguments.cpp b/hotspot/src/share/vm/runtime/arguments.cpp
--- a/hotspot/src/share/vm/runtime/arguments.cpp
+++ b/hotspot/src/share/vm/runtime/arguments.cpp
@@ -1593,9 +1593,16 @@
 void Arguments::select_gc_ergonomically() {
+#ifdef __ANDROID__
+  // Android phones benefit from the throughput-oriented parallel collector
+  // for Minecraft workloads. Explicit user-selected collectors are preserved
+  // because select_gc() calls this only when no collector was selected.
+  FLAG_SET_ERGO(bool, UseParallelGC, true);
+#else
   if (os::is_server_class_machine()) {
     if (should_auto_select_low_pause_collector()) {
       FLAG_SET_ERGO(bool, UseConcMarkSweepGC, true);
     } else {
       FLAG_SET_ERGO(bool, UseParallelGC, true);
     }
   }
+#endif
 }
